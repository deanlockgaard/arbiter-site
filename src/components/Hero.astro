---
import {
  CTA_PILOT_ARIA_LABEL,
  CTA_PILOT_LABEL,
  MAILTO_PILOT,
} from '../constants/site.ts';

const primaryButton =
  'inline-block border border-zinc-300 text-zinc-100 px-5 py-2.5 text-sm font-medium rounded-sm hover:bg-zinc-900 hover:border-zinc-100 no-underline';
const bodyParagraph = 'text-base md:text-lg leading-relaxed text-zinc-400';
---

<section aria-labelledby="hero-heading" class="py-20 md:py-32">
  <div class="max-w-5xl mx-auto px-6">
    <h1
      id="hero-heading"
      class="text-4xl md:text-5xl lg:text-6xl font-semibold text-zinc-100 max-w-4xl mb-6"
    >
      A merge gate for AI-written code changes.
    </h1>
    <p class="text-lg md:text-xl text-zinc-300 max-w-3xl mb-6">
      For CISOs and engineering leaders who let AI agents change code.
    </p>
    <p class={`${bodyParagraph} max-w-3xl mb-10`}>
      Arbiter checks every pull request that touches sensitive code against your
      policy, kept as code in your own GitHub. It allows, blocks or escalates the
      change before it can merge, whether a person or an AI agent wrote it. It runs
      in your own environment, with your own GitHub App.
    </p>
    <a
      href={MAILTO_PILOT}
      aria-label={CTA_PILOT_ARIA_LABEL}
      class={primaryButton}>{CTA_PILOT_LABEL}</a
    >
  </div>
</section>
