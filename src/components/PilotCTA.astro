---
import {
  CTA_PILOT_ARIA_LABEL,
  CTA_PILOT_LABEL,
  MAILTO_PILOT,
} from '../constants/site.ts';

const bodyParagraph = 'text-base md:text-lg leading-relaxed text-zinc-400';
const surfaceCard = 'border border-zinc-800 bg-zinc-900 rounded-sm p-6';
const primaryButton =
  'inline-block border border-zinc-300 text-zinc-100 px-5 py-2.5 text-sm font-medium rounded-sm hover:bg-zinc-900 hover:border-zinc-100 no-underline';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="py-20 md:py-28 border-t border-zinc-800"
>
  <div class="max-w-5xl mx-auto px-6">
    <div class={surfaceCard}>
      <h2 id="contact-heading" class="text-2xl md:text-3xl mb-8">
        Request a Pilot
      </h2>
      <p class={bodyParagraph}>Talk to us about a pilot deployment.</p>
      <a
        href={MAILTO_PILOT}
        aria-label={CTA_PILOT_ARIA_LABEL}
        class={`${primaryButton} mt-8`}>{CTA_PILOT_LABEL}</a
      >
    </div>
  </div>
</section>
