---
import { SITE } from '../constants/site.ts';
---

<footer class="border-t border-zinc-800 py-10">
  <div
    class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row md:justify-between md:items-start gap-6 text-sm text-zinc-500"
  >
    <div class="flex flex-col gap-2">
      <span>{SITE.copyright}</span>
      <a
        href={`mailto:${SITE.email}`}
        class="text-zinc-400 hover:text-zinc-100 no-underline">{SITE.email}</a
      >
      <a
        href={SITE.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-400 hover:text-zinc-100 no-underline">LinkedIn</a
      >
    </div>
    <div>{SITE.location}</div>
  </div>
</footer>
