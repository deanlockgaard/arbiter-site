---
import { SITE } from '../constants/site.ts';
---

<footer class="border-t border-zinc-800 py-10">
  <div class="max-w-5xl mx-auto px-6 text-sm">
    <div class="flex flex-col gap-2 items-start text-zinc-400">
      <span>{SITE.name}</span>
      <span>{SITE.location}</span>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-4 text-zinc-400 hover:text-zinc-100 no-underline">{SITE.email}</a
      >
      <a
        href={SITE.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-400 hover:text-zinc-100 no-underline">LinkedIn</a
      >
      <span class="mt-4">{SITE.copyright}</span>
    </div>
  </div>
</footer>
